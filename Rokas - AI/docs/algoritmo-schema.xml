        <mxCell id="b11" value="&lt;div style=&quot;line-height:29px;padding-top:6px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;11. Įmaišyti bendrą įvesties ilgį&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;(kaip atskirą žingsnį)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="905" y="706" width="582" height="84" as="geometry"/></mxCell>
        <mxCell id="b12" value="&lt;div style=&quot;line-height:29px;padding-top:6px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;12. Atlikti 3 maišymo žingsnius be įvesties&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;Papildomai sumaišo būseną&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="905" y="820" width="582" height="84" as="geometry"/></mxCell>
        <mxCell id="sect_y" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FEF0BE;strokeColor=#EBB234;strokeWidth=3;verticalAlign=top;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="883.5" y="948" width="625" height="502" as="geometry"/></mxCell>
        <mxCell id="b13" value="&lt;div style=&quot;line-height:27px;padding-top:6px&quot;&gt;&lt;b style=&quot;font-size:24px&quot;&gt;13. Sulenkti 512 bitų būseną į 256 bitų išvestį&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;out0 = s0 XOR rotl(s4, 40)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;out1 = s1 XOR rotl(s5, 40)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;out2 = s2 XOR rotl(s6, 40)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;out3 = s3 XOR rotl(s7, 40)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="905" y="1010" width="582" height="174" as="geometry"/></mxCell>
        <mxCell id="b14" value="&lt;div style=&quot;line-height:25px;padding-top:6px&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;14. Serializuoti išvesties žodžius didžiojo galo tvarka&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;Užrašyti out0..out3 didžiojo galo tvarka&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;(32 baitai = 256 bitai)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="905" y="1216" width="582" height="100" as="geometry"/></mxCell>
