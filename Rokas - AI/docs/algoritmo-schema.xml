        <mxCell id="pradzia" value="&lt;div style=&quot;line-height:40px;padding-top:4px&quot;&gt;&lt;b style=&quot;font-size:27px&quot;&gt;Pradžia&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1E2E4;strokeColor=#1A1A1A;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="241" y="146" width="328" height="72" as="geometry"/></mxCell>
        <mxCell id="b1" value="&lt;div style=&quot;line-height:31px;padding-top:2px&quot;&gt;&lt;b style=&quot;font-size:27px&quot;&gt;1. Inicializuoti būseną: s0..s7&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;8 x 64 bitų būsenos dalys (512 bitų) su fiksuotomis konstantomis&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="75" y="256" width="660" height="94" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;div style=&quot;line-height:32px;padding-top:4px&quot;&gt;&lt;b style=&quot;font-size:27px&quot;&gt;2. Paversti įvestį į baitus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px&quot;&gt;ASCII/UTF-8 simboliai paverčiami baitais&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="75" y="384" width="660" height="94" as="geometry"/></mxCell>
        <mxCell id="dia" value="&lt;div style=&quot;line-height:38px&quot;&gt;&lt;b style=&quot;font-size:27px&quot;&gt;Ar yra daugiau pilnų&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:27px&quot;&gt;32 baitų blokų?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDC1C3;strokeColor=#CE1214;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="186" y="510" width="438" height="206" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;div style=&quot;line-height:29px;padding-top:6px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;3. Paimti kitą 32 baitų bloką&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px&quot;&gt;Perskaityti kitus 32 baitus iš įvesties&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="93" y="770" width="624" height="88" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;div style=&quot;line-height:28px;padding-top:8px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;4. Padalyti bloką į 4 žodžius (po 8 baitus)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;word0, word1, word2, word3&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px&quot;&gt;(didžiojo galo tvarka)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="93" y="892" width="624" height="118" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;div style=&quot;line-height:28px;padding-top:7px&quot;&gt;&lt;b style=&quot;font-size:27px&quot;&gt;5. Įterpti žodžius į būseną&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px&quot;&gt;s0 += word0 XOR tag&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:27px&quot;&gt;s2 ^= word1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px&quot;&gt;s4 += word2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:27px&quot;&gt;s6 ^= word3&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="93" y="1042" width="624" height="190" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;div style=&quot;line-height:34px;padding-bottom:1px&quot;&gt;&lt;b style=&quot;font-size:27px&quot;&gt;6. Tiesioginis perėjimas (i = 1..7)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:29px&quot;&gt;s[i] = (s[i] XOR rotl(s[i-1], 41)) * MUL_F&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="93" y="1266" width="624" height="102" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;div style=&quot;line-height:33px;padding-top:2px&quot;&gt;&lt;b style=&quot;font-size:27px&quot;&gt;7. Atgalinis perėjimas (i = 6..0)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:30px&quot;&gt;s[i] = (s[i] + rotl(s[i+1], 53)) * MUL_B&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="93" y="1402" width="624" height="102" as="geometry"/></mxCell>
        <mxCell id="sect_g" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#DBEDDA;strokeColor=#689E58;strokeWidth=3;verticalAlign=top;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="883.5" y="156" width="625" height="460" as="geometry"/></mxCell>
        <mxCell id="b8" value="&lt;div style=&quot;line-height:27px;padding-top:4px&quot;&gt;&lt;b style=&quot;font-size:25px&quot;&gt;8. Sudėti likusius baitus į 32 baitų buferį&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;Nepanaudoti baitai užpildomi nuliais&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;(0–31 likę baitai)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="905" y="220" width="582" height="112" as="geometry"/></mxCell>
        <mxCell id="b9" value="&lt;div style=&quot;line-height:26px;padding-top:4px&quot;&gt;&lt;b style=&quot;font-size:25px&quot;&gt;9. Padalyti likučių buferį į 4 žodžius&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;word0, word1, word2, word3&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;(didžiojo galo tvarka)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="905" y="366" width="582" height="112" as="geometry"/></mxCell>
        <mxCell id="b10" value="&lt;div style=&quot;line-height:30px;padding-top:6px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;10. Apdoroti likutį su specialiu likučio tag&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;(likučių ilgis įtrauktas į tag)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="905" y="514" width="582" height="86" as="geometry"/></mxCell>
