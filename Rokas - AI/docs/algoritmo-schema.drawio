<mxfile host="app.diagrams.net" agent="handmade" type="device">
  <diagram id="hash-schema" name="Maišos algoritmo schema V0.13">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2020" pageHeight="1992" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;div style=&quot;line-height:52px&quot;&gt;&lt;b style=&quot;font-size:38px&quot;&gt;Pasirinktinio 256 bitų maišos algoritmo schema · V0.13&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:27px&quot;&gt;512 bitų vidinė būsena, 32 baitų blokai, 2 maišymo raundai, grįžtamasis ryšys, 256 bitų išvestis&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="18" width="1900" height="110" as="geometry"/></mxCell>
        <mxCell id="pradzia" value="&lt;div style=&quot;line-height:40px&quot;&gt;&lt;b style=&quot;font-size:27px&quot;&gt;Pradžia&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1E2E4;strokeColor=#1A1A1A;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="150" width="330" height="72" as="geometry"/></mxCell>
        <mxCell id="b1" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;1. Inicializuoti būseną: s0..s7&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;8 × 64 bitų dalys (512 bitų) su fiksuotomis konstantomis&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="75" y="258" width="640" height="98" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;2. Paversti įvestį į baitus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;tekstas – UTF-8 baitai, failas – tikslūs jo baitai&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="75" y="392" width="640" height="98" as="geometry"/></mxCell>
        <mxCell id="dia" value="&lt;div style=&quot;line-height:36px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;Ar yra daugiau pilnų&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:26px&quot;&gt;32 baitų blokų?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDC1C3;strokeColor=#CE1214;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="175" y="526" width="440" height="208" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;3. Paimti kitą 32 baitų bloką&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;perskaityti kitus 32 baitus iš įvesties&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="75" y="788" width="640" height="98" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;4. Padalyti bloką į 4 žodžius (po 8 baitus)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;word0, word1, word2, word3&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;(didžiojo galo tvarka)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="75" y="922" width="640" height="131" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;5. Įsiminti būseną: t = s&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;kopija grįžtamajam ryšiui (9 žingsnis)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="75" y="1089" width="640" height="98" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;6. Įterpti žodžius į būseną&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;s0 += word0 XOR tag&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;s2 ^= word1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;s4 += word2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;s6 ^= word3&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="75" y="1223" width="640" height="197" as="geometry"/></mxCell>
        <mxCell id="sect_r" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FDE1CF;strokeColor=#D9772B;strokeWidth=3;verticalAlign=top;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65" y="1456" width="660" height="328" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;7. Tiesioginis perėjimas (i = 1..7)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;s[i] = (s[i] XOR rotl(s[i-1], 41)) * MUL_F&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="75" y="1522" width="580" height="98" as="geometry"/></mxCell>
        <mxCell id="b8" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;8. Atgalinis perėjimas (i = 6..0)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;s[i] = (s[i] + rotl(s[i+1], 53)) * MUL_B&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="75" y="1656" width="580" height="98" as="geometry"/></mxCell>
        <mxCell id="h_r" value="&lt;b style=&quot;font-size:26px&quot;&gt;Maišymo raundas – 2 kartus&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="65" y="1460" width="660" height="58" as="geometry"/></mxCell>
        <mxCell id="b9" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;9. Grįžtamasis ryšys: s[i] ^= t[i] (i = 0..7)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;žingsnio nebegalima atsukti atgal&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="75" y="1820" width="640" height="98" as="geometry"/></mxCell>
        <mxCell id="sect_g" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#DBEDDA;strokeColor=#689E58;strokeWidth=3;verticalAlign=top;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="872.5" y="150" width="625" height="491" as="geometry"/></mxCell>
        <mxCell id="b10" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;10. Sudėti likusius baitus į 32 baitų buferį&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;nepanaudoti baitai užpildomi nuliais&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;(0–31 likęs baitas)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="899" y="216" width="572" height="131" as="geometry"/></mxCell>
        <mxCell id="b11" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;11. Padalyti buferį į 4 žodžius&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;word0, word1, word2, word3&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="899" y="383" width="572" height="98" as="geometry"/></mxCell>
        <mxCell id="b12" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;12. Tas pats žingsnis (5–9) su likučiu&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;tag įtraukia likučio ilgį&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="899" y="517" width="572" height="98" as="geometry"/></mxCell>
        <mxCell id="h_sect_g" value="&lt;b style=&quot;font-size:26px&quot;&gt;Likučio apdorojimas&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="872.5" y="154" width="625" height="58" as="geometry"/></mxCell>
        <mxCell id="sect_p" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#D8CEEC;strokeColor=#8E69B7;strokeWidth=3;verticalAlign=top;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="872.5" y="685" width="625" height="324" as="geometry"/></mxCell>
        <mxCell id="b13" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;13. Įmaišyti įvesties ilgį L&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;žingsnis (5–9) su žodžiais L, rotl(L, 32), 0, 0&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="899" y="751" width="572" height="98" as="geometry"/></mxCell>
        <mxCell id="b14" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;14. 3 žingsniai (5–9) be įvesties&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;papildomai sumaišo būseną&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="899" y="885" width="572" height="98" as="geometry"/></mxCell>
        <mxCell id="h_sect_p" value="&lt;b style=&quot;font-size:26px&quot;&gt;Baigiamasis apdorojimas&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="872.5" y="689" width="625" height="58" as="geometry"/></mxCell>
        <mxCell id="sect_y" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FEF0BE;strokeColor=#EBB234;strokeWidth=3;verticalAlign=top;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="872.5" y="1053" width="625" height="557" as="geometry"/></mxCell>
        <mxCell id="b15" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;15. Sulenkti 512 bitų būseną į 256 bitus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;out0 = s0 XOR rotl(s4, 40)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;out1 = s1 XOR rotl(s5, 40)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;out2 = s2 XOR rotl(s6, 40)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;out3 = s3 XOR rotl(s7, 40)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="899" y="1119" width="572" height="197" as="geometry"/></mxCell>
        <mxCell id="b16" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;16. Užrašyti žodžius didžiojo galo tvarka&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;out0..out3 → 32 baitai = 256 bitai&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="899" y="1352" width="572" height="98" as="geometry"/></mxCell>
        <mxCell id="b17" value="&lt;div style=&quot;line-height:33px&quot;&gt;&lt;b style=&quot;font-size:26px&quot;&gt;17. Užrašyti šešioliktainiu formatu&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;32 baitai = 64 simboliai, mažosios raidės&lt;/span&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="899" y="1486" width="572" height="98" as="geometry"/></mxCell>
        <mxCell id="h_sect_y" value="&lt;b style=&quot;font-size:26px&quot;&gt;Sukurti 256 bitų išvestį&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="872.5" y="1057" width="625" height="58" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;div style=&quot;line-height:34px&quot;&gt;&lt;b style=&quot;font-size:25px&quot;&gt;Galutinė maiša&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px&quot;&gt;(64 šešioliktainiai simboliai)&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1E2E4;strokeColor=#1A1A1A;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="975" y="1654" width="420" height="88" as="geometry"/></mxCell>
        <mxCell id="t_leg" value="&lt;b style=&quot;font-size:30px&quot;&gt;Legenda&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1567" y="176" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="lg0" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1E2E4;strokeColor=#1A1A1A;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1569" y="226" width="110" height="48" as="geometry"/></mxCell>
        <mxCell id="lg0_t" value="&lt;span style=&quot;font-size:21px&quot;&gt;Pradžia / pabaiga&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1703" y="226" width="270" height="48" as="geometry"/></mxCell>
        <mxCell id="lg1" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C9E4FE;strokeColor=#1A467E;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="1569" y="292" width="110" height="48" as="geometry"/></mxCell>
        <mxCell id="lg1_t" value="&lt;span style=&quot;font-size:21px&quot;&gt;Proceso žingsnis&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1703" y="292" width="270" height="48" as="geometry"/></mxCell>
        <mxCell id="lg2" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDC1C3;strokeColor=#CE1214;strokeWidth=3;fontFamily=Helvetica;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1569" y="347" width="110" height="70" as="geometry"/></mxCell>
        <mxCell id="lg2_t" value="&lt;span style=&quot;font-size:21px&quot;&gt;Sprendimas&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1703" y="358" width="270" height="48" as="geometry"/></mxCell>
        <mxCell id="lg3" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDE1CF;strokeColor=#D9772B;strokeWidth=3;verticalAlign=top;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1569" y="424" width="110" height="48" as="geometry"/></mxCell>
        <mxCell id="lg3_t" value="&lt;span style=&quot;font-size:21px&quot;&gt;Maišymo raundas (×2)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1703" y="424" width="270" height="48" as="geometry"/></mxCell>
        <mxCell id="lg4" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DBEDDA;strokeColor=#689E58;strokeWidth=3;verticalAlign=top;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1569" y="490" width="110" height="48" as="geometry"/></mxCell>
        <mxCell id="lg4_t" value="&lt;span style=&quot;font-size:21px&quot;&gt;Likučio apdorojimas&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1703" y="490" width="270" height="48" as="geometry"/></mxCell>
        <mxCell id="lg5" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D8CEEC;strokeColor=#8E69B7;strokeWidth=3;verticalAlign=top;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1569" y="556" width="110" height="48" as="geometry"/></mxCell>
        <mxCell id="lg5_t" value="&lt;span style=&quot;font-size:21px&quot;&gt;Baigiamasis apdorojimas&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1703" y="556" width="270" height="48" as="geometry"/></mxCell>
