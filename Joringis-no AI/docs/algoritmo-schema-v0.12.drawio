        <mxCell id="lg2t" value="&lt;span style=&quot;font-size:16px&quot;&gt;Sprendimas&lt;/span&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1564" y="72" width="300" height="32" as="geometry"/></mxCell>
        <mxCell id="lg3" value="" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;dashed=1;dashPattern=6 4;fillColor=#DDEEEC;strokeColor=#2F7F79;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1930" y="72" width="70" height="32" as="geometry"/></mxCell>
        <mxCell id="lg3t" value="&lt;span style=&quot;font-size:16px&quot;&gt;Pasukimų grupė&lt;/span&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2014" y="72" width="300" height="32" as="geometry"/></mxCell>
        <mxCell id="l1" value="A. Paruošimas" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;swimlane;startSize=52;fillColor=#1F5F5B;swimlaneFillColor=#F4F9F8;strokeColor=#1F5F5B;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;rounded=0;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="500" height="930" as="geometry"/></mxCell>
        <mxCell id="l2" value="B. Bloko ciklas" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;swimlane;startSize=52;fillColor=#1F5F5B;swimlaneFillColor=#F4F9F8;strokeColor=#1F5F5B;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;rounded=0;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="580" y="140" width="760" height="930" as="geometry"/></mxCell>
        <mxCell id="l3" value="C. Paskutinis blokas ir pabaiga" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;swimlane;startSize=52;fillColor=#1F5F5B;swimlaneFillColor=#F4F9F8;strokeColor=#1F5F5B;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;rounded=0;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1380" y="140" width="500" height="930" as="geometry"/></mxCell>
        <mxCell id="l4" value="D. Išvestis" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;swimlane;startSize=52;fillColor=#1F5F5B;swimlaneFillColor=#F4F9F8;strokeColor=#1F5F5B;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;rounded=0;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1920" y="140" width="460" height="930" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b style=&quot;font-size:21px&quot;&gt;Pradžia&lt;/b&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;ellipse;fillColor=#1F5F5B;strokeColor=#1F5F5B;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="160" y="215" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;1. Pradinė būsena s0..s7&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;8 × 32 bitų stipinai – frazė&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;„Vilniaus universitetas, BGT 2026“,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;mažojo galo žodžiai&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7F79;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="325" width="440" height="140" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;2. Įvestis → baitai&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;tekstas – UTF-8,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;failas – tikslūs jo baitai&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7F79;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="505" width="440" height="110" as="geometry"/></mxCell>
        <mxCell id="dec" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:21px;color:#000000&quot;&gt;Liko pilnas&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:21px;color:#000000&quot;&gt;16 baitų blokas?&lt;/b&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;size=36;fillColor=#FFE8A3;strokeColor=#B38600;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="665" width="440" height="150" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;3. Kitas 16 baitų blokas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;numeris n = 1, 2, 3, … (64 bitai)&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7F79;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="215" width="680" height="95" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;4. h = s&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;būsenos kopija feed-forward žingsniui&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7F79;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="345" width="680" height="90" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;5. Bloko įterpimas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;s0..s3 ^= w0..w3 (mažojo galo žodžiai)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;s6 += n aukštieji 32 bitai,  s7 += n žemieji 32 bitai&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7F79;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="470" width="680" height="130" as="geometry"/></mxCell>
        <mxCell id="grp" value="&lt;b style=&quot;font-size:20px&quot;&gt;Rato pasukimas ×2&lt;/b&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;dashed=1;dashPattern=6 4;fillColor=#DDEEEC;strokeColor=#2F7F79;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="610" y="640" width="700" height="270" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;6. Stipinas i = 0..7&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;a = s[i] + (s[i+1] XOR s[i+3])&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;a = rotl(a, s[i+6] mod 32; 0 → 1)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;a = a XOR (s[i+6] + rc(r))&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7F79;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="630" y="690" width="430" height="170" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;7. Perdavimas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;s[i] = a&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;s[i+1] += rotl(a, 9)&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7F79;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1085" y="690" width="205" height="170" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;8. Feed-forward&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;s[i] += h[i],  i = 0..7&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7F79;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="945" width="680" height="90" as="geometry"/></mxCell>
        <mxCell id="s9" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;9. Likutis + užpildas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;likę 0–15 baitų; trūksta k baitų →&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;k baitų reikšme k (PKCS#7)&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7F79;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1405" y="215" width="450" height="120" as="geometry"/></mxCell>
        <mxCell id="s10" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;10. Bloko žingsnis 4–8&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;su paskutiniu numeriu n&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7F79;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1405" y="375" width="450" height="95" as="geometry"/></mxCell>
        <mxCell id="s11" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;11. Ilgis L ir žymė&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;s4 ^= L žemieji 32 bitai&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;s5 ^= L aukštieji 32 bitai&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;s6 ^= 0xFFFFFFFF&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7F79;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1405" y="510" width="450" height="150" as="geometry"/></mxCell>
        <mxCell id="s12" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;12. 4 pasukimai (6–7)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;be įvesties&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7F79;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1405" y="700" width="450" height="95" as="geometry"/></mxCell>
        <mxCell id="s13" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;13. Pirma pusė&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;s0..s3 → baitai 0..15&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7F79;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1940" y="215" width="420" height="95" as="geometry"/></mxCell>
        <mxCell id="s14" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;14. 2 pasukimai (6–7)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;kad išvestis nebūtų visa būsena&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7F79;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1940" y="350" width="420" height="95" as="geometry"/></mxCell>
        <mxCell id="s15" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;15. Antra pusė&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;s0..s3 → baitai 16..31&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7F79;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1940" y="485" width="420" height="95" as="geometry"/></mxCell>
        <mxCell id="s16" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;16. Hex užrašas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;64 simboliai, mažosios raidės&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#2F7F79;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1940" y="620" width="420" height="95" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b style=&quot;font-size:21px&quot;&gt;Maiša (64 hex)&lt;/b&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;ellipse;fillColor=#1F5F5B;strokeColor=#1F5F5B;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2010" y="760" width="280" height="80" as="geometry"/></mxCell>
