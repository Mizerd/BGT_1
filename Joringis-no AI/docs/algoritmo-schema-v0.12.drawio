        <mxCell id="title" value="&lt;div style=&quot;line-height:44px&quot;&gt;&lt;b style=&quot;font-size:34px&quot;&gt;Ratas-256 · v0.12&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;256 bitų „ratas“ iš 8 stipinų · 16 baitų blokai · 2 pasukimai bloke · feed-forward · 256 bitų išvestis&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1300" height="100" as="geometry"/></mxCell>
