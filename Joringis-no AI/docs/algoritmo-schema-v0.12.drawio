        <mxCell id="lg0t" value="&lt;span style=&quot;font-size:16px&quot;&gt;Pradžia / pabaiga&lt;/span&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1564" y="28" width="300" height="32" as="geometry"/></mxCell>
