        <mxCell id="ideas_t" value="&lt;b style=&quot;font-size:22px&quot;&gt;Pagrindinės idėjos&lt;/b&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1092" width="600" height="40" as="geometry"/></mxCell>
        <mxCell id="i0" value="&lt;span style=&quot;font-size:17px&quot;&gt;Būsena – ratas iš 8 stipinų; įvestis įmaišoma po 16 baitų į s0..s3&lt;/span&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#9FC5C1;strokeWidth=2;align=left;verticalAlign=top;spacing=10;spacingLeft=14;shape=partialRectangle;right=0;top=0;bottom=0;left=1;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="318" height="96" as="geometry"/></mxCell>
        <mxCell id="i1" value="&lt;span style=&quot;font-size:17px&quot;&gt;Naujas stipinas iškart pridedamas prie kito – pokytis per pasukimą apeina ratą&lt;/span&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#9FC5C1;strokeWidth=2;align=left;verticalAlign=top;spacing=10;spacingLeft=14;shape=partialRectangle;right=0;top=0;bottom=0;left=1;" vertex="1" parent="1"><mxGeometry x="374" y="1140" width="318" height="96" as="geometry"/></mxCell>
        <mxCell id="i2" value="&lt;span style=&quot;font-size:17px&quot;&gt;Posūkio dydis priklauso nuo duomenų (s[i+6]), visada 1..31 bitų&lt;/span&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#9FC5C1;strokeWidth=2;align=left;verticalAlign=top;spacing=10;spacingLeft=14;shape=partialRectangle;right=0;top=0;bottom=0;left=1;" vertex="1" parent="1"><mxGeometry x="708" y="1140" width="318" height="96" as="geometry"/></mxCell>
        <mxCell id="i3" value="&lt;span style=&quot;font-size:17px&quot;&gt;rc(r) = IV[r mod 8]·(2r+1) + r, r – visų pasukimų skaitiklis&lt;/span&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#9FC5C1;strokeWidth=2;align=left;verticalAlign=top;spacing=10;spacingLeft=14;shape=partialRectangle;right=0;top=0;bottom=0;left=1;" vertex="1" parent="1"><mxGeometry x="1042" y="1140" width="318" height="96" as="geometry"/></mxCell>
        <mxCell id="i4" value="&lt;span style=&quot;font-size:17px&quot;&gt;Feed-forward: bloko žingsnio neatsuksi nuo rezultato&lt;/span&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#9FC5C1;strokeWidth=2;align=left;verticalAlign=top;spacing=10;spacingLeft=14;shape=partialRectangle;right=0;top=0;bottom=0;left=1;" vertex="1" parent="1"><mxGeometry x="1376" y="1140" width="318" height="96" as="geometry"/></mxCell>
        <mxCell id="i5" value="&lt;span style=&quot;font-size:17px&quot;&gt;Ilgis, užpildas ir 64 bitų numeris – skirtingo ilgio įvestys nesutampa&lt;/span&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#9FC5C1;strokeWidth=2;align=left;verticalAlign=top;spacing=10;spacingLeft=14;shape=partialRectangle;right=0;top=0;bottom=0;left=1;" vertex="1" parent="1"><mxGeometry x="1710" y="1140" width="318" height="96" as="geometry"/></mxCell>
        <mxCell id="i6" value="&lt;span style=&quot;font-size:17px&quot;&gt;Išvestis – dvi pusės su pasukimais tarp jų&lt;/span&gt;" style="fontFamily=Verdana;fontColor=#1B2B2A;html=1;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;strokeColor=#9FC5C1;strokeWidth=2;align=left;verticalAlign=top;spacing=10;spacingLeft=14;shape=partialRectangle;right=0;top=0;bottom=0;left=1;" vertex="1" parent="1"><mxGeometry x="2044" y="1140" width="318" height="96" as="geometry"/></mxCell>
