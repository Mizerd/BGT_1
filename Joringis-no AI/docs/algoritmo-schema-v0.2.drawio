        <mxCell id="n1" value="&lt;b style=&quot;font-size:18px;color:#D1342F&quot;&gt;v0.2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;Failas maišomas dalimis: 1 GiB failui ≈ 6 MB atminties (v0.12 – ≈ 1,9 GB; vienkartinis matavimas).&lt;/span&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FDECEA;strokeColor=#D1342F;strokeWidth=2;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1110" y="470" width="440" height="150" as="geometry"/></mxCell>
        <mxCell id="n1l" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D1342F;strokeWidth=2;jumpStyle=gap;jumpSize=14;edgeStyle=none;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n2" value="&lt;b style=&quot;font-size:18px;color:#D1342F&quot;&gt;v0.2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;3 pasukimai vietoj 2. SAC: su 1 pasukimu 15 752 iš 32 768 langelių šališki, su 2 – 0; 3 = atsarga 1,5×.&lt;/span&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FDECEA;strokeColor=#D1342F;strokeWidth=2;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1110" y="1400" width="440" height="150" as="geometry"/></mxCell>
        <mxCell id="n2l" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D1342F;strokeWidth=2;jumpStyle=gap;jumpSize=14;edgeStyle=none;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n2" target="grp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n3" value="&lt;b style=&quot;font-size:18px;color:#D1342F&quot;&gt;v0.2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;Pabaigos pasukimų nebegalima tiesiog atsukti iki būsenos prieš ilgio įmaišymą.&lt;/span&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#FDECEA;strokeColor=#D1342F;strokeWidth=2;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1110" y="2340" width="440" height="150" as="geometry"/></mxCell>
        <mxCell id="n3l" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#D1342F;strokeWidth=2;jumpStyle=gap;jumpSize=14;edgeStyle=none;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n3" target="s12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ideas" value="&lt;b style=&quot;font-size:23px&quot;&gt;Idėja trumpai&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px;line-height:32px&quot;&gt;• Ratas iš 8 stipinų, įvestis po 16 baitų į s0..s3&lt;br&gt;• Pokytis per pasukimą apeina visą ratą&lt;br&gt;• Posūkis priklauso nuo duomenų, 1..31 bitų&lt;br&gt;• rc(r) = IV[r mod 8]·(2r+1) + r&lt;br&gt;• Feed-forward – žingsnių neatsuksi vien sukant atgal&lt;br&gt;• Ilgis ir užpildas – skirtingi ilgiai po užpildymo skiriasi&lt;/span&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8FA9C9;strokeWidth=2;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1080" y="2570" width="480" height="330" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
