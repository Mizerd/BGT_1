        <mxCell id="bandt0" value="&lt;b style=&quot;font-size:20px;letter-spacing:3px&quot;&gt;PARUOŠIMAS&lt;/b&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rotation=-90;" vertex="1" parent="1"><mxGeometry x="-130.0" y="393.0" width="420" height="44" as="geometry"/></mxCell>
        <mxCell id="band1" value="" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=0;fillColor=#F3EAF7;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="625" width="1560" height="1255" as="geometry"/></mxCell>
        <mxCell id="bandt1" value="&lt;b style=&quot;font-size:20px;letter-spacing:3px&quot;&gt;BLOKŲ CIKLAS&lt;/b&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rotation=-90;" vertex="1" parent="1"><mxGeometry x="-547.5" y="1230.5" width="1255" height="44" as="geometry"/></mxCell>
        <mxCell id="band2" value="" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=0;fillColor=#E9F3EC;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="1880" width="1560" height="640" as="geometry"/></mxCell>
        <mxCell id="bandt2" value="&lt;b style=&quot;font-size:20px;letter-spacing:3px&quot;&gt;PASKUTINIS BLOKAS IR PABAIGA&lt;/b&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rotation=-90;" vertex="1" parent="1"><mxGeometry x="-240.0" y="2178.0" width="640" height="44" as="geometry"/></mxCell>
        <mxCell id="band3" value="" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=0;fillColor=#EAF1FA;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="2520" width="1560" height="680" as="geometry"/></mxCell>
        <mxCell id="bandt3" value="&lt;b style=&quot;font-size:20px;letter-spacing:3px&quot;&gt;IŠVESTIS&lt;/b&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rotation=-90;" vertex="1" parent="1"><mxGeometry x="-260.0" y="2838.0" width="680" height="44" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b style=&quot;font-size:22px&quot;&gt;Pradžia&lt;/b&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#7A3E1D;strokeColor=#7A3E1D;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="550" y="235" width="300" height="64" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;div style=&quot;line-height:29px&quot;&gt;&lt;b style=&quot;font-size:23px;color:#000000&quot;&gt;1. Pradinė būsena s0..s7&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;8 × 32 bitų stipinai = frazė&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;„Vilniaus universitetas, BGT 2026“ (mažojo galo)&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=22;fillColor=#FFFFFF;strokeColor=#C0622B;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="335" width="560" height="120" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;div style=&quot;line-height:29px&quot;&gt;&lt;b style=&quot;font-size:23px;color:#000000&quot;&gt;2. Įvestis → baitai&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;tekstas – UTF-8; failas – tikslūs baitai,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;skaitomi 64 KiB dalimis&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=22;fillColor=#FFFFFF;strokeColor=#C0622B;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;strokeColor=#D1342F;strokeWidth=4;dashed=1;dashPattern=10 5;" vertex="1" parent="1"><mxGeometry x="420" y="490" width="560" height="110" as="geometry"/></mxCell>
        <mxCell id="dec" value="&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;Yra dar pilnas&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;line-height:28px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;16 baitų blokas?&lt;/b&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rhombus;fillColor=#EBD9F5;strokeColor=#7B3F9E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="490" y="650" width="420" height="190" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;div style=&quot;line-height:29px&quot;&gt;&lt;b style=&quot;font-size:23px;color:#000000&quot;&gt;3. Kitas 16 baitų blokas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;numeris n = 1, 2, 3, … (64 bitai)&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=22;fillColor=#FFFFFF;strokeColor=#C0622B;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="880" width="560" height="100" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;div style=&quot;line-height:29px&quot;&gt;&lt;b style=&quot;font-size:23px;color:#000000&quot;&gt;4. h = s&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;kopija feed-forward žingsniui&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=22;fillColor=#FFFFFF;strokeColor=#C0622B;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="1010" width="560" height="90" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;div style=&quot;line-height:29px&quot;&gt;&lt;b style=&quot;font-size:23px;color:#000000&quot;&gt;5. Bloko įterpimas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;s0..s3 ^= w0..w3 (mažojo galo)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;s6 += n aukštieji 32 bitai&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;s7 += n žemieji 32 bitai&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=22;fillColor=#FFFFFF;strokeColor=#C0622B;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="1130" width="560" height="150" as="geometry"/></mxCell>
        <mxCell id="grp" value="&lt;b style=&quot;font-size:22px&quot;&gt;Rato pasukimas ×3&lt;/b&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#F7EDFB;strokeColor=#7B3F9E;strokeWidth=2;verticalAlign=top;align=center;spacingTop=8;strokeColor=#D1342F;strokeWidth=4;dashed=1;dashPattern=10 5;" vertex="1" parent="1"><mxGeometry x="425" y="1310" width="550" height="410" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;div style=&quot;line-height:29px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;6. Stipinas i = 0..7&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;b = s[(i+1) mod 8],  c = s[(i+3) mod 8]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;d = s[(i+6) mod 8]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;a = s[i] + (b XOR c)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;a = rotl(a, d mod 32; 0 → 1)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;a = a XOR (d + rc(r))&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=22;fillColor=#FFFFFF;strokeColor=#C0622B;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="1365" width="460" height="200" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;div style=&quot;line-height:29px&quot;&gt;&lt;b style=&quot;font-size:22px;color:#000000&quot;&gt;7. Perduoti kitam stipinui&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;s[i] = a;  s[(i+1) mod 8] += rotl(a, 9)&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=22;fillColor=#FFFFFF;strokeColor=#C0622B;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="1600" width="460" height="95" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;div style=&quot;line-height:29px&quot;&gt;&lt;b style=&quot;font-size:23px;color:#000000&quot;&gt;8. Feed-forward&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;s[i] += h[i],  i = 0..7&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=22;fillColor=#FFFFFF;strokeColor=#C0622B;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="1750" width="560" height="95" as="geometry"/></mxCell>
        <mxCell id="s9" value="&lt;div style=&quot;line-height:29px&quot;&gt;&lt;b style=&quot;font-size:23px;color:#000000&quot;&gt;9. Likutis + užpildas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;likę 0–15 baitų; trūksta k → k baitų reikšme k&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;(PKCS#7; be likučio – visas blokas 0x10)&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=22;fillColor=#FFFFFF;strokeColor=#C0622B;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="1920" width="560" height="125" as="geometry"/></mxCell>
        <mxCell id="s10" value="&lt;div style=&quot;line-height:29px&quot;&gt;&lt;b style=&quot;font-size:23px;color:#000000&quot;&gt;10. Bloko žingsnis 4–8&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;su paskutiniu numeriu n&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=22;fillColor=#FFFFFF;strokeColor=#C0622B;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="2080" width="560" height="95" as="geometry"/></mxCell>
        <mxCell id="s11" value="&lt;div style=&quot;line-height:29px&quot;&gt;&lt;b style=&quot;font-size:23px;color:#000000&quot;&gt;11. Ilgis L ir uždarymo žymė&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;s4 ^= L žemieji 32 bitai,  s5 ^= L aukštieji&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;s6 ^= 0xFFFFFFFF&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=22;fillColor=#FFFFFF;strokeColor=#C0622B;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="2210" width="560" height="120" as="geometry"/></mxCell>
        <mxCell id="s12" value="&lt;div style=&quot;line-height:29px&quot;&gt;&lt;b style=&quot;font-size:23px;color:#000000&quot;&gt;12. f = s;  4 pasukimai;  s += f&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;feed-forward ir pabaigoje&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=22;fillColor=#FFFFFF;strokeColor=#C0622B;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;strokeColor=#D1342F;strokeWidth=4;dashed=1;dashPattern=10 5;" vertex="1" parent="1"><mxGeometry x="420" y="2370" width="560" height="100" as="geometry"/></mxCell>
        <mxCell id="s13" value="&lt;div style=&quot;line-height:29px&quot;&gt;&lt;b style=&quot;font-size:23px;color:#000000&quot;&gt;13. Pirma pusė&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;s0..s3 → išvesties baitai 0..15&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=22;fillColor=#FFFFFF;strokeColor=#C0622B;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="2550" width="560" height="95" as="geometry"/></mxCell>
        <mxCell id="s14" value="&lt;div style=&quot;line-height:29px&quot;&gt;&lt;b style=&quot;font-size:23px;color:#000000&quot;&gt;14. 2 pasukimai (6–7)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;tarp pusių – ne visa būsena vienu metu&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=22;fillColor=#FFFFFF;strokeColor=#C0622B;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="2680" width="560" height="95" as="geometry"/></mxCell>
        <mxCell id="s15" value="&lt;div style=&quot;line-height:29px&quot;&gt;&lt;b style=&quot;font-size:23px;color:#000000&quot;&gt;15. Antra pusė&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;s0..s3 → išvesties baitai 16..31&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=22;fillColor=#FFFFFF;strokeColor=#C0622B;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="2810" width="560" height="95" as="geometry"/></mxCell>
        <mxCell id="s16" value="&lt;div style=&quot;line-height:29px&quot;&gt;&lt;b style=&quot;font-size:23px;color:#000000&quot;&gt;16. Hex užrašas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;32 baitai = 64 simboliai, mažosios raidės&lt;/span&gt;&lt;/div&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=22;fillColor=#FFFFFF;strokeColor=#C0622B;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="2940" width="560" height="95" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b style=&quot;font-size:22px&quot;&gt;Maiša – 64 hex simboliai&lt;/b&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#7A3E1D;strokeColor=#7A3E1D;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="530" y="3075" width="340" height="76" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7A3E1D;strokeWidth=3;endArrow=open;endSize=10;fontFamily=Trebuchet MS;" edge="1" parent="1" source="start" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7A3E1D;strokeWidth=3;endArrow=open;endSize=10;fontFamily=Trebuchet MS;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
