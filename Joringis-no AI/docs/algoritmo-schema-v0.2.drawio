        <mxCell id="lg3t" value="&lt;span style=&quot;font-size:16px&quot;&gt;Pasukimų grupė&lt;/span&gt;" style="fontFamily=Trebuchet MS;fontColor=#2B1A10;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="888" y="142" width="180" height="34" as="geometry"/></mxCell>
